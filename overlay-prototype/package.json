{
  "name": "overlay-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:overlays": "node ./scripts/build.js",
    "figma:claude": "node --env-file=.env ./scripts/figma-claude.js",
    "figma:gemini": "node --env-file=.env ./scripts/gemini.js",
    "figma:debug": "node ./scripts/gemini-debug.js",
    "figma:batch": "node --env-file=.env ./scripts/gemini-batch.js",
    "post-gemini": "node ./scripts/post-gemini.js",
    "pipeline": "npm run figma:batch && npm run post-gemini && npm run build:overlays"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@google/genai": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "fast-xml-parser": "^5.7.3"
  }
}
